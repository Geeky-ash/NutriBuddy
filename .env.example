# NutriBuddy Environment Configuration
# Copy this file to .env and insert your personal API keys

# Google Gemini API Key (1.5 Flash Vision)
EXPO_PUBLIC_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# OpenAI API Key (GPT-4o Vision)
EXPO_PUBLIC_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Default AI Provider ('gemini' | 'openai' | 'mock')
EXPO_PUBLIC_AI_PROVIDER=gemini

# Application Environment ('development' | 'staging' | 'production')
EXPO_PUBLIC_APP_ENV=development
