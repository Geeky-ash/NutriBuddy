# NutriBuddy Environment Configuration
# Copy this file to .env and insert your personal API keys

# Google Gemini API Key
EXPO_PUBLIC_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Supabase Connectivity
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co/rest/v1/
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# AI Configuration
EXPO_PUBLIC_AI_PROVIDER=gemini
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite

# Application Environment ('development' | 'staging' | 'production')
EXPO_PUBLIC_APP_ENV=development
